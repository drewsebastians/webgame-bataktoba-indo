{
  "name": "webgame-bataktoba-indo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "python tools/build-learning-data.py",
    "build:seo": "node tools/generate-sitemap.mjs",
    "build": "node tools/build-dist.mjs",
    "build:ads-txt": "node tools/generate-ads-txt.mjs",
    "check": "node tools/check-site.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "e2e": "node tools/e2e-smoke.mjs",
    "serve:e2e": "node tools/e2e-server.mjs 4179",
    "test:browser": "playwright test",
    "verify:core": "npm run check && npm run build && npm run test && npm run e2e && npm run test:browser",
    "verify:drift": "git diff --exit-code -- dist",
    "verify": "npm run verify:core && npm run verify:drift",
    "start": "python -m http.server 4173"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1"
  }
}
