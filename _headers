/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Filenames are not content-hashed yet, so long-lived immutable caching
# would serve stale code after deploys. Revalidation instead; hashed assets
# may switch to immutable once the build produces versioned filenames.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

/data/published/*
  Cache-Control: public, max-age=3600, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate
